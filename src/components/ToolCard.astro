---
import type { Tool } from '../types';
import StatusBadge from './StatusBadge.astro';
import { href } from '../lib/paths';
import { isRecent } from '../lib/tools';

interface Props { tool: Tool; }
const { tool } = Astro.props;

const fresh = isRecent(tool.latestRelease?.published_at ?? null);

// Everything the client-side filter matches against, lowercased once at build.
const haystack = [
  tool.name,
  tool.command,
  tool.tagline,
  tool.repo.language ?? '',
  tool.repo.full_name,
  ...tool.platforms,
].join(' ').toLowerCase();
---

<article
  class="card"
  data-tool
  data-status={tool.status}
  data-language={tool.repo.language ?? ''}
  data-search={haystack}
>
  <div class="card-top">
    <div>
      <h3><a href={href(`tools/${tool.command}/`)}>{tool.name}</a></h3>
      <span class="cmd">{tool.command}</span>
    </div>
    <StatusBadge status={tool.status} />
  </div>

  <p class="tagline">{tool.tagline}</p>

  <div class="card-foot">
    {tool.version ? (
      <span class={fresh ? 'ver new' : 'ver'}>
        {tool.version}{fresh && ' · new'}
      </span>
    ) : (
      <span class="ver">no release</span>
    )}

    {tool.repo.language && (
      <span class="lang"><i class="dot"></i>{tool.repo.language}</span>
    )}

    {tool.repo.stars > 0 && (
      <span class="stars">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3.1-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z"/>
        </svg>
        <span class="sr-only">Stars:</span>{tool.repo.stars}
      </span>
    )}
  </div>
</article>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
