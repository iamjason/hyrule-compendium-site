---
import { STATUSES } from '../types';
import { CATEGORY_LABELS, languages, populatedCategories } from '../lib/tools';

const cats = populatedCategories();
const langs = languages();
---

<div class="filters">
  <div class="wrap">
    <div class="search-field">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="m15.5 15.5 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <label class="sr-only" for="f-search">Search tools</label>
      <input
        id="f-search"
        type="search"
        placeholder="Search tools, commands, languages…"
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <div class="select-field">
      <label class="sr-only" for="f-category">Filter by category</label>
      <select id="f-category">
        <option value="">All categories</option>
        {cats.map((c) => <option value={c}>{CATEGORY_LABELS[c]}</option>)}
      </select>
    </div>

    <div class="select-field">
      <label class="sr-only" for="f-status">Filter by status</label>
      <select id="f-status">
        <option value="">All statuses</option>
        {STATUSES.map((s) => <option value={s}>{s[0].toUpperCase() + s.slice(1)}</option>)}
      </select>
    </div>

    {langs.length > 1 && (
      <div class="select-field">
        <label class="sr-only" for="f-language">Filter by language</label>
        <select id="f-language">
          <option value="">All languages</option>
          {langs.map((l) => <option value={l}>{l}</option>)}
        </select>
      </div>
    )}

    <button class="reset" type="button" id="f-reset" hidden>Clear</button>
    <p class="result-count" id="f-count" role="status" aria-live="polite"></p>
  </div>
</div>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .result-count {
    margin: 0; font-family: var(--font-mono);
    font-size: 0.76rem; color: var(--text-faint);
  }
  @media (max-width: 640px) {
    .result-count { width: 100%; }
  }
</style>
