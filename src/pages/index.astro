---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, isRecent } from '../lib/tools';

const shippedRecently = tools.filter((t) => isRecent(t.latestRelease?.published_at ?? null)).length;
---

<Base title="Compendium" nav="tools">
  <section class="hero traced">
    <div class="wrap">
      <h1>Compendium</h1>
      <p>
        Every tool I maintain, catalogued automatically. Entries are discovered
        by the <code>hyrule-tool</code> topic and refresh themselves whenever
        one of them cuts a release.
      </p>
      <div class="counts">
        <span><b>{tools.length}</b> tools</span>
        {shippedRecently > 0 && <span><b>{shippedRecently}</b> shipped in the last 30 days</span>}
      </div>
    </div>
  </section>

  <div class="wrap">
    {tools.length > 0 && (
      <div class="grid tool-grid" role="list">
        {tools.map((tool) => <ToolCard tool={tool} />)}
      </div>
    )}

    {tools.length === 0 && (
      <div class="empty">
        <strong>No tools discovered yet.</strong>
        Tag a repo with the <code>hyrule-tool</code> topic and run <code>npm run fetch</code>.
      </div>
    )}
  </div>
</Base>

<style>
  .tool-grid { padding-top: 44px; }
</style>
