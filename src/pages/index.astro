---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import FilterBar from '../components/FilterBar.astro';
import { CATEGORY_LABELS, populatedCategories, toolsIn, tools, isRecent } from '../lib/tools';

const cats = populatedCategories();
const stable = tools.filter((t) => t.status === 'stable').length;
const shippedRecently = tools.filter((t) => isRecent(t.latestRelease?.published_at ?? null)).length;
---

<Base title="Compendium" nav="tools">
  <section class="hero traced">
    <div class="wrap">
      <h1>Compendium</h1>
      <p>
        Every tool I maintain, catalogued automatically. Entries are discovered
        by the <code>hyrule-tool</code> topic and refresh themselves whenever
        one of them cuts a release.
      </p>
      <div class="counts">
        <span><b>{tools.length}</b> tools</span>
        <span><b>{cats.length}</b> categories</span>
        <span><b>{stable}</b> stable</span>
        {shippedRecently > 0 && <span><b>{shippedRecently}</b> shipped in the last 30 days</span>}
      </div>
    </div>
  </section>

  <FilterBar />

  <div class="wrap">
    {cats.map((category) => (
      <section class="category" data-category-section data-hidden="false">
        <div class="category-head">
          <h2 id={`cat-${category}`}>{CATEGORY_LABELS[category]}</h2>
          <span class="n" data-section-count>{toolsIn(category).length}</span>
          <span class="rule"></span>
        </div>
        <div class="grid" role="list" aria-labelledby={`cat-${category}`}>
          {toolsIn(category).map((tool) => <ToolCard tool={tool} />)}
        </div>
      </section>
    ))}

    {tools.length === 0 && (
      <div class="empty">
        <strong>No tools discovered yet.</strong>
        Tag a repo with the <code>hyrule-tool</code> topic and run <code>npm run fetch</code>.
      </div>
    )}

    <div class="empty" id="no-results" hidden>
      <strong>Nothing matches those filters.</strong>
      Try a broader search, or clear the filters.
    </div>
  </div>
</Base>

<script>
  import '../scripts/filter.ts';
</script>
